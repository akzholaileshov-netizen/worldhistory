# Көшіріп .env деп атаңыз және мәндерін толтырыңыз. .env файлын ешқашан git-ке салмаңыз!

# Telegram бот токені (@BotFather)
BOT_TOKEN=

# Supabase -> Project Settings -> Database -> Connection string (URI)
# Pooler (Transaction mode, порт 6543) немесе Direct connection қолдануға болады
DATABASE_URL=postgresql://postgres.xxxx:PASSWORD@aws-0-xx.pooler.supabase.com:6543/postgres

# Gemini API кілті (3-7 кезеңдерде қолданылады, әзірге бос қалдыруға болады)
GEMINI_API_KEY=

# Админ Telegram ID-лері, үтірмен бөлінген: 12345,67890
ADMIN_IDS=

# Әдепкі пән коды (world_history | kazakh_history)
DEFAULT_SUBJECT=world_history

# Журнал деңгейі: DEBUG | INFO | WARNING
LOG_LEVEL=INFO
